# Base server settings
APP_HOST=127.0.0.1
APP_PORT=8000

# File and passage limits for a 4 GB laptop
MAX_UPLOAD_MB=10
MINIMUM_PASSAGE_WORDS=5
MINIMUM_MATCH_SCORE=0.35

# Hybrid model settings. The weights must sum to 1.0.
LEXICAL_WEIGHT=0.55
SEMANTIC_WEIGHT=0.45

# Leave semantic mode disabled until the base application is stable.
SEMANTIC_ENABLED=false
SEMANTIC_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

