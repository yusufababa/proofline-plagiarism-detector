# Base server settings
APP_HOST=127.0.0.1
APP_PORT=8000

# File and passage limits for a 4 GB laptop
MAX_UPLOAD_MB=10
MINIMUM_PASSAGE_WORDS=5
MINIMUM_MATCH_SCORE=0.15
SEMANTIC_MINIMUM_MATCH_SCORE=0.20
LEXICAL_MEDIUM_REVIEW_SCORE=0.25
LEXICAL_HIGH_REVIEW_SCORE=0.69
HYBRID_MEDIUM_REVIEW_SCORE=0.46
HYBRID_HIGH_REVIEW_SCORE=0.80

# Hybrid model settings. The weights must sum to 1.0.
LEXICAL_WEIGHT=0.55
SEMANTIC_WEIGHT=0.45

# Leave semantic mode disabled until the base application is stable.
SEMANTIC_ENABLED=false
SEMANTIC_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# Optional: use a writable folder elsewhere if the project data directory is restricted.
# SEMANTIC_CACHE_DIR=C:\path\to\proofline-model-cache

# Hosted demo settings. Keep the password blank for localhost use only.
SEED_DEMO_CORPUS=false
APP_ACCESS_USERNAME=proofline
APP_ACCESS_PASSWORD=
# Hosted platforms should point this at a writable runtime directory.
# DATA_DIR=/tmp/proofline-data
